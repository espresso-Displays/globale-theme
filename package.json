{
  "name": "globale-theme",
  "version": "1.0.0",
  "description": "Shopify theme for the espresso Displays Global-e storefront",
  "main": "tailwind.config.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./assets/tailwind.css -o ./assets/style.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./assets/tailwind.css -o ./assets/style.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"shopify theme dev\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/container-queries": "^0.1.1"
  },
  "devDependencies": {
    "@headlessui/tailwindcss": "^0.2.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.17"
  }
}

{% assign section = section | replace: '{', '' | replace: '}', '' | strip %}
{% assign pairs = section | split: '|||' %}
{% assign media_type = '' %}
{% assign media_name = '' %}
{% assign media_alt = '' %}
{% assign layout = layout | default: 'imageLeft' %}
{% assign className = '' %}

{% for pair in pairs %}
  {% assign key_value = pair | split: ':' %}
  {% assign key = key_value[0] | strip | remove: '"' %}
  {% assign value = key_value[1] | strip | remove: '"' %}
  {% if key == 'media_type' %}
    {% assign media_type = value %}
  {% elsif key == 'media_name' %}
    {% assign media_name = value | strip | remove: '"' | append: '.webp' %}
  {% elsif key == 'media_alt' %}
    {% assign media_alt = value %}
  {% endif %}
{% endfor %}

{%- comment -%} Layout logic {%- endcomment -%}
{% if layout == 'imageRight' %}
  {% assign gridInverse = 'order-first desktop-small:order-last' %}
  {% assign colStartStyles = 'full desktop-small:half-padded' %}
  {% assign colSpanStyles = 'full desktop-small:half-padded' %}
{% else %}
  {% assign gridInverse = 'order-first desktop-small:order-first' %}
  {% assign colStartStyles = 'full desktop-small:half-padded' %}
  {% assign colSpanStyles = 'full desktop-small:half-padded' %}
{% endif %}

{% assign current_variant = product.selected_or_first_available_variant %}

{% capture media_content %}
  {% if variant_media and current_variant.featured_media %}
    <img
      class="tech-spec-image"
      src="{{ current_variant.featured_media | image_url: width: 1600 }}"
      alt="{{ media_alt }}"
      width="{{ current_variant.featured_media.preview_image.width }}"
      height="{{ current_variant.featured_media.preview_image.height }}"
    >
  {% elsif media_type == 'video' %}
    <video src="{{ media_name | file_url }}" controls></video>
  {% elsif media_type == 'image' %}
    <img
      src="{{ media_name | file_url }}"
      alt="{{ media_alt }}"
      width="{{ images[media_name].width }}"
      height="{{ images[media_name].height }}"
    >
  {% endif %}
{% endcapture %}

{% capture text_content %}
  <h2 class="text-display-small text-left" id="section-techspecs">Tech specs</h2>
  <div class="tech-spec-list contents">
    {% for spec in current_variant.metafields.custom.tech_specs.value %}
      <div class="lg:col-start-1 lg:col-span-10 text-body-large">{{ spec }}</div>
    {% endfor %}
  </div>

  {% assign spec_sheet = current_variant.metafields.custom.technical_spec_sheet.value %}
  <div class="tech-spec-sheet h-full w-full flex flex-col items-start col-span-full{% if spec_sheet == blank %} hidden{% endif %}">
    <a
      href="{{ spec_sheet }}"
      draggable="false"
      rel="noopener noreferrer"
      target="_blank"
      class="rounded-[5px] flex flex-row text-center items-center justify-center gap-[16px] whitespace-pre-wrap bg-lm-primary text-lm-on-primary hover:bg-lm-primary-hover active:bg-lm-primary-click px-[16px] py-[8px] text-label-medium w-fit h-[48px] cursor-pointer"
      >Download tech spec sheet</a
    >
  </div>
{% endcapture %}

{% capture inner_content %}
  {% render 'layout-flex',
    colStart: colStartStyles,
    colSpan: colSpanStyles,
    className: 'content-container flex flex-col justify-start gap-[32px] desktop-small:gap-[32px] py-[32px] desktop-small:py-[0px]',
    content: text_content
  %}
{% endcapture %}

{% assign mediaClass = 'media ' | append: gridInverse %}

{% capture grid_content %}
  {% render 'layout-flex',
    colSpan: 'full desktop-small:half',
    className: mediaClass,
    content: media_content
  %}
  {% render 'layout-grid',
    colSpan: 'full desktop-small:half',
    className: 'auto-rows-auto',
    content: inner_content
  %}
{% endcapture %}

{% render 'layout-grid', className: 'section image-with-info gap-[16px] ', append: className, content: grid_content %}

{% if product.variants.size > 1 %}
  <script type="application/json" class="variant-spec-data">
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "specs": {{ variant.metafields.custom.tech_specs.value | json }},
          "sheet": {{ variant.metafields.custom.technical_spec_sheet.value | json }},
          "image": {% if variant_media and variant.featured_media %}{{ variant.featured_media | image_url: width: 1600 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const dataScript = document.querySelector('.variant-spec-data');
      if (!dataScript) return;
      const variants = JSON.parse(dataScript.textContent);
      const list = document.querySelector('.tech-spec-list');
      const sheet = document.querySelector('.tech-spec-sheet');
      const image = document.querySelector('.tech-spec-image');

      document.querySelectorAll('.collection-variant-button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const data = variants[btn.getAttribute('data-variant-id')];
          if (!data) return;

          if (list && Array.isArray(data.specs)) {
            list.replaceChildren(
              ...data.specs.map((spec) => {
                const row = document.createElement('div');
                row.className = 'lg:col-start-1 lg:col-span-10 text-body-large';
                row.textContent = spec;
                return row;
              })
            );
          }

          if (sheet) {
            sheet.classList.toggle('hidden', !data.sheet);
            if (data.sheet) sheet.querySelector('a').href = data.sheet;
          }

          if (image && data.image) image.src = data.image;
        });
      });
    });
  </script>
{% endif %}
{% comment %}

